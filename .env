# ==============================================================================
# Universal Secretaries - Consultation Booking & Microsoft 365 Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Consultant Details (Sri Lanka UTC+5:30)
CONSULTANT_NAME="Senior Tax & Corporate Advisor"
CONSULTANT_EMAIL="snisal@corporate.mediadefined.com"
CONSULTANT_PHONE="94774087869"
CONSULTANT_TIMEZONE="Asia/Colombo"

# ------------------------------------------------------------------------------
# Microsoft 365 / Microsoft Teams Authentication
# ------------------------------------------------------------------------------
# OPTION 1: Direct Consultant Username & Password (ROPC)
# Enter your Microsoft 365 account password here to directly update your calendar.
MICROSOFT_USER_NAME="snisal@corporate.mediadefined.com"
MICROSOFT_USER_PASSWORD=""

# OPTION 2: Microsoft Entra ID (Azure AD) App Registration
# If using an Azure App Registration, set your client credentials here:
MICROSOFT_TENANT_ID="organizations"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# High-Fidelity Simulation Fallback (set to true for offline / dev testing)
MICROSOFT_GRAPH_FALLBACK_SIMULATION=true

# Email Confirmation
SEND_CONFIRMATION_EMAIL=true
